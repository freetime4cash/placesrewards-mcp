amber-300 font-medium\">\n                                <x-ui.icon icon=\"coins\" class=\"w-4 h-4\" />\n                                <span>{{ trans('common.need') }} <span class=\"format-number\">{{ $reward->points - $balance }}</span> {{ trans('common.more_points') }}</span>\n                            </div>\n                        @endif\n                    @else\n                        {{-- Login required --}}\n                        <a href=\"{{ route('member.login') }}\"\n                            class=\"group inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-secondary-900 dark:bg-white hover:bg-secondary-800 dark:hover:bg-secondary-100 text-white dark:text-secondary-900 font-semibold rounded-xl shadow-lg transition-all duration-300\">\n                            <x-ui.icon icon=\"log-in\" class=\"w-5 h-5 group-hover:translate-x-0.5 rtl:group-hover:-translate-x-0.5 transition-transform\" />\n                            <span>{{ trans('common.log_in_to_claim_reward') }}</span>\n                        </a>\n                    @endif\n                @endif\n            </div>\n        </div>\n    </div>\n\n    {{-- More Rewards (Increased top spacing for breathing room) --}}\n    <div class=\"bg-white mt-8 dark:bg-secondary-900 rounded-xl border border-secondary-200 dark:border-secondary-800 shadow-sm animate-fade-in-up\" style=\"animation-delay: 200ms;\">\n        <div class=\"p-6\">\n            <x-member.rewards :card=\"$card\" :current-reward=\"$reward\" :show-claimable=\"true\" />\n        </div>\n    </div>\n\n    {{-- Tier Status for This Club (Contextual - Above Add/Remove) --}}\n    @if(isset($memberTierData) && $memberTierData)\n        <div class=\"w-full max-w-2xl mx-auto mt-8\">\n            <x-member.tier-status \n                :memberTier=\"$memberTierData['memberTier']\"\n                :club=\"$memberTierData['club']\"\n                :card=\"$memberTierData['card']\"\n                :progress=\"$memberTierData['progress']\" />\n        </div>\n    @endif\n\n    {{-- Add/Remove Card Button - Below tier, above share (uniform spacing) --}}\n    <div class=\"w-full max-w-2xl mx-auto\">\n        <x-member.follow-card :card=\"$card\" />\n    </div>\n\n    {{-- Share - Page utility at the end --}}\n    @if(!$card->isExpired)\n        <div class=\"w-full max-w-lg mx-auto flex justify-center\">\n            <x-ui.share :url=\"url()->current()\" :text=\"$card->head . ' - ' . $reward->title\" size=\"lg\" />\n        </div>\n    @endif\n</div>\n@stop",
        "resources/views/member/scratch-cards/show.blade.php": "@extends('member.layouts.default')\n\n@section('page_title', 'Scratch Card' . config('default.page_title_delimiter') . config('default.app_name'))\n\n@section('content')\n<div class=\"w-full max-w-lg mx-auto px-4 md:px-6 py-6 md:py-8\">\n\n    <div class=\"mb-6 flex items-center gap-3\">\n        <a href=\"{{ route('member.scratch-cards.index') }}\"\n            class=\"inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-secondary-700 dark:text-secondary-300 \nbg-white dark:bg-secondary-800 border border-stone-200 dark:border-secondary-700 rounded-xl shadow-sm hover:bg-stone-50 \ndark:hover:bg-secondary-700 transition-colors duration-200\">\n            <x-ui.icon icon=\"arrow-left\" class=\"w-4 h-4\" />\n            My Cards\n        </a>\n    </div>\n\n    <div class=\"bg-white dark:bg-secondary-900 rounded-2xl border border-stone-200 dark:border-secondary-800 shadow-sm \noverflow-hidden\">\n\n        <div class=\"p-6 text-center border-b border-stone-200 dark:border-secondary-800\">\n            <h1 class=\"text-xl font-bold text-secondary-900 dark:text-white mb-1\">{{ $scratchCard->scratchGame->name }}</h1>\n            <p class=\"text-xs text-secondary-500 dark:text-secondary-400 font-mono\">{{ $scratchCard->identifier }}</p>\n        </div>\n\n        <div class=\"p-6\" x-data=\"scratchCard({\n            isPlayed: {{ $scratchCard->is_played ? 'true' : 'false' }},\n            isWinner: {{ $scratchCard->is_winner ? 'true' : ($scratchCard->is_played ? 'false' : 'null') }},\n            playUrl: '{{ route('member.scratch-cards.play', $scratchCard) }}',\n            csrfToken: '{{ csrf_token() }}',\n            coverImage: '{{ $scratchCard->scratchGame->cover_image ? asset('storage/' . $scratchCard->scratchGame->cover_image) : '' }}',\n            winImage: '{{ $scratchCard->scratchGame->win_image ? asset('storage/' . $scratchCard->scratchGame->win_image) : '' }}',\n            lossImage: '{{ $scratchCard->scratchGame->loss_image ? asset('storage/' . $scratchCard->scratchGame->loss_image) : '' \n}}',\n        })\">\n\n            {{-- Cover Image / Scratch Area --}}\n            <div class=\"relative mb-6\">\n                @if(!$scratchCard->is_played)\n                    {{-- Scratch Canvas --}}\n                    <div class=\"relative w-full aspect-square max-w-sm mx-auto rounded-2xl overflow-hidden\">\n                        {{-- Result layer (underneath) --}}\n                        <div id=\"result-layer\" class=\"absolute inset-0 flex items-center justify-center bg-gradient-to-br \nfrom-secondary-100 to-secondary-200 dark:from-secondary-800 dark:to-secondary-900\">\n                            <div x-show=\"isWinner === true\" class=\"text-center\">\n                                <div class=\"text-6xl mb-2\">🏆</div>\n                                <p class=\"text-2xl font-bold text-emerald-600 dark:text-emerald-400\">YOU WIN!</p>\n                            </div>\n                            <div x-show=\"isWinner === false\" class=\"text-center\">\n                                <div class=\"text-6xl mb-2\">😔</div>\n                                <p class=\"text-2xl font-bold text-secondary-600 dark:text-secondary-400\">Better luck next time!</p>\n                            </div>\n                            <div x-show=\"isWinner === null\" class=\"text-center\">\n                                <x-ui.icon icon=\"sparkles\" class=\"w-16 h-16 text-secondary-300 dark:text-secondary-600 mx-auto \nmb-2\" />\n                                <p class=\"text-secondary-500 dark:text-secondary-400\">Scratch to reveal!</p>\n                            </div>\n                        </div>\n                        {{-- Scratch layer (on top) --}}\n                        <canvas id=\"scratch-canvas\" class=\"absolute inset-0 w-full h-full cursor-crosshair\" \nx-show=\"!isPlayed\"></canvas>\n                    </div>\n\n                    {{-- Scratch instructions --}}\n                    <p x-show=\"!isPlayed\" class=\"text-center text-sm text-secondary-500 dark:text-secondary-400 mt-3\">\n                        Use your finger or mouse to scratch the card\n                    </p>\n                @else\n                    {{-- Already played --}}\n                    <div class=\"w-full aspect-square max-w-sm mx-auto rounded-2xl overflow-hidden flex items-center justify-center \nbg-gradient-to-br from-secondary-100 to-secondary-200 dark:from-secondary-800 dark:to-secondary-900\">\n                        @if($scratchCard->is_winner)\n                            @if($scratchCard->scratchGame->win_image)\n                                <img src=\"{{ asset('storage/' . $scratchCard->scratchGame->win_image) }}\" class=\"w-full h-full \nobject-cover\">\n                            @else\n                                <div class=\"text-center\">\n                                    <div class=\"text-6xl mb-2\">🏆</div>\n                                    <p class=\"text-2xl font-bold text-emerald-600 dark:text-emerald-400\">YOU WIN!</p>\n                                </div>\n                            @endif\n                        @else\n                            @if($scratchCard->scratchGame->loss_image)\n                                <img src=\"{{ asset('storage/' . $scratchCard->scratchGame->loss_image) }}\" class=\"w-full h-full \nobject-cover\">\n                            @else\n                                <div class=\"text-center\">\n                                    <div class=\"text-6xl mb-2\">😔</div>\n                                    <p class=\"text-2xl font-bold text-secondary-600 dark:text-secondary-400\">Better luck next \ntime!</p>\n                                </div>\n                            @endif\n                        @endif\n                    </div>\n                @endif\n            </div>\n\n            {{-- Result message --}}\n            <div x-show=\"isPlayed\" class=\"text-center mb-4\">\n                <div x-show=\"isWinner\" class=\"p-4 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 border border-emerald-200 \ndark:border-emerald-800\">\n                    <p class=\"font-bold text-emerald-700 dark:text-emerald-400\">🎉 Congratulations! You won!</p>\n                    <p class=\"text-sm text-emerald-600 dark:text-emerald-500 mt-1\">Please show this screen to claim your prize.</p>\n                </div>\n                <div x-show=\"!isWinner\" class=\"p-4 rounded-xl bg-secondary-50 dark:bg-secondary-800 border border-secondary-200 \ndark:border-secondary-700\">\n                    <p class=\"font-medium text-secondary-700 dark:text-secondary-300\">Thanks for playing!</p>\n                    <p class=\"text-sm text-secondary-500 dark:text-secondary-400 mt-1\">Better luck next time.</p>\n                </div>\n            </div>\n\n            <div class=\"text-center\">\n                <a href=\"{{ route('member.scratch-cards.index') }}\"\n                    class=\"inline-flex items-center gap-2 px-6 py-3 text-sm font-medium text-secondary-700 dark:text-secondary-300 \nbg-stone-100 dark:bg-secondary-800 hover:bg-stone-200 dark:hover:bg-secondary-700 rounded-xl transition-colors duration-200\">\n                    <x-ui.icon icon=\"arrow-left\" class=\"w-4 h-4\" />\n                    Back to My Cards\n                </a>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\nfunction scratchCard(config) {\n    return {\n        isPlayed: config.isPlayed,\n        isWinner: config.isWinner,\n        playUrl: config.playUrl,\n        csrfToken: config.csrfToken,\n        coverImage: config.coverImage,\n        winImage: config.winImage,\n        lossImage: config.lossImage,\n        scratchProgress: 0,\n\n        init() {\n            if (!this.isPlayed) {\n                this.$nextTick(() => this.initCanvas());\n            }\n        },\n\n        initCanvas() {\n            const canvas = document.getElementById('scratch-canvas');\n            if (!canvas) return;\n\n            const ctx = canvas.getContext('2d');\n            const rect = canvas.parentElement.getBoundingClientRect();\n            canvas.width = rect.width;\n            canvas.height = rect.height;\n\n            // TREASURE_HUNT_COVER_RENDERER\n            const drawFallbackSurface = () => {\n                ctx.globalCompositeOperation = 'source-over';\n                ctx.globalAlpha = 1;\n                ctx.fillStyle = '#C0C0C0';\n                ctx.fillRect(0, 0, canvas.width, canvas.height);\n                ctx.fillStyle = '#A0A0A0';\n                ctx.font = 'bold 16px sans-serif';\n                ctx.textAlign = 'center';\n                for (let y = 30; y < canvas.height; y += 40) {\n                    for (let x = 60; x < canvas.width; x += 120) {\n                        ctx.fillText('SCRATCH', x, y);\n                    }\n                }\n            };\n\n            drawFallbackSurface();\n            if (this.coverImage) {\n                const cover = new Image();\n                cover.crossOrigin = 'anonymous';\n                cover.onload = () => {\n                    if (this.scratchProgress > 0 || this.isPlayed) return;\n                    ctx.globalCompositeOperation = 'source-over';\n                    ctx.globalAlpha = 1;\n                    ctx.clearRect(0, 0, canvas.width, canvas.height);\n                    const imageRatio = cover.width / cover.height;\n                    const canvasRatio = canvas.width / canvas.height;\n                    let sx = 0, sy = 0, sw = cover.width, sh = cover.height;\n                    if (imageRatio > canvasRatio) {\n                        sw = cover.height * canvasRatio;\n                        sx = (cover.width - sw) / 2;\n                    } else {\n                        sh = cover.width / canvasRatio;\n                        sy = (cover.height - sh) / 2;\n                    }\n                    ctx.drawImage(cover, sx, sy, sw, sh, 0, 0, canvas.width, canvas.height);\n                };\n                cover.onerror = drawFallbackSurface;\n                cover.src = this.coverImage;\n            }\n            let isScratching = false;\n            let checkTimer = null;\n\n            const getPos = (e) => {\n                const r = canvas.getBoundingClientRect();\n                const src = e.touches ? e.touches[0] : e;\n                return {\n                    x: (src.clientX - r.left) * (canvas.width / r.width),\n                    y: (src.clientY - r.top) * (canvas.height / r.height),\n                };\n            };\n\n            const scratch = (x, y) => {\n                ctx.globalCompositeOperation = 'destination-out';\n                ctx.beginPath();\n                ctx.arc(x, y, 28, 0, Math.PI * 2);\n                ctx.fill();\n\n                if (!checkTimer) {\n                    checkTimer = setTimeout(() => {\n                        checkTimer = null;\n                        this.checkReveal(ctx, canvas);\n                    }, 150);\n                }\n            };\n\n            canvas.addEventListener('mousedown', (e) => { isScratching = true; const p = getPos(e); scratch(p.x, p.y); });\n            canvas.addEventListener('mousemove', (e) => { if (isScratching) { const p = getPos(e); scratch(p.x, p.y); } });\n            canvas.addEventListener('mouseup', () => { isScratching = false; });\n            canvas.addEventListener('touchstart', (e) => { e.preventDefault(); isScratching = true; const p = getPos(e); \nscratch(p.x, p.y); });\n            canvas.addEventListener('touchmove', (e) => { e.preventDefault(); if (isScratching) { const p = getPos(e); scratch(p.x, \np.y); } });\n            canvas.addEventListener('touchend', () => { isScratching = false; });\n        },\n\n        checkReveal(ctx, canvas) {\n            const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;\n            let transparent = 0;\n            for (let i = 3; i < data.length; i += 16) {\n                if (data[i] < 128) transparent++;\n            }\n            const pct = (transparent / (canvas.width * canvas.height / 4)) * 100;\n            if (pct > 45) {\n                this.reveal(canvas);\n            }\n        },\n\n        async reveal(canvas) {\n            if (this.isPlayed) return;\n\n            try {\n                const response = await fetch(this.playUrl, {\n                    method: 'POST',\n                    headers: {\n                        'Content-Type': 'application/json',\n                        'X-CSRF-TOKEN': this.csrfToken,\n                        'Accept': 'application/json',\n                    },\n                });\n\n                const data = await response.json();\n\n                if (data.already_played) {\n                    this.isPlayed = true;\n                    this.isWinner = data.is_winner;\n                    return;\n                }\n\n                this.isPlayed = true;\n                this.isWinner = data.is_winner;\n\n                // Remove canvas\n                if (canvas) canvas.remove();\n\n                // Show result image if available\n                const resultLayer = document.getElementById('result-layer');\n                if (resultLayer && data.is_winner && data.win_image) {\n                    resultLayer.innerHTML = `<img src=\"${data.win_image}\" class=\"w-full h-full object-cover\">`;\n                } else if (resultLayer && !data.is_winner && data.loss_image) {\n                    resultLayer.innerHTML = `<img src=\"${data.loss_image}\" class=\"w-full h-full object-cover\">`;\n                }\n\n            } catch (error) {\n                console.error('Error revealing card:', error);\n            }\n        }\n    };\n}\n</script>\n@stop\n",
        "resources/views/components/member/premium-card.blade.php": "{{--\nPremium Loyalty Card Component\nClean, crisp, Revolut-style design.\nNo weird filters, just pure content and perfect typography.\n\nUses CSS container queries to scale text based on card width:\n- In grids: compact text\n- Standalone: larger, more prominent text\n--}}\n@php\n    // Calculate shadow class based on TEXT color (not background - users set text color explicitly)\n    // Light text (white) needs dark shadow, dark text needs light shadow\n    $textHex = ltrim($textColor, '#');\n    if (strlen($textHex) === 3) {\n        $textHex = $textHex[0].$textHex[0].$textHex[1].$textHex[1].$textHex[2].$textHex[2];\n    }\n    $textR = hexdec(substr($textHex, 0, 2));\n    $textG = hexdec(substr($textHex, 2, 2));\n    $textB = hexdec(substr($textHex, 4, 2));\n    $textLuminance = (0.299 * $textR) + (0.587 * $textG) + (0.114 * $textB);\n    // Light text (like white) gets black shadow for contrast; dark text gets white shadow\n    $shadowClass = $textLuminance > 128 ? 'text-shadow-subtle-black' : 'text-shadow-subtle-white';\n@endphp\n<div {{ $attributes->except('class') }} id=\"{{ $element_id }}\"\n    class=\"premium-card group relative w-full h-full max-w-[700px] mx-auto rounded-3xl overflow-hidden select-none @container {{ $attributes->get('class') }}\"\n    @if($authCheck && $urlToEarnPoints)\n        data-pwa-card\n        data-pwa-card-id=\"{{ $id }}\"\n        data-pwa-card-type=\"loyalty\"\n        data-pwa-card-name=\"{{ $contentHead }}\"\n        data-pwa-card-balance=\"{{ $balance }} {{ trans('common.points') }}\"\n        data-pwa-card-qr=\"{{ $urlToEarnPoints }}\"\n    @endif\n>\n\n    {{-- Clickable Wrapper --}}\n    @if ($links)\n        @if (($customLink ?? null))\n            <a href=\"{{ $customLink }}\" class=\"card-hit absolute inset-0 z-20\"></a>\n        @elseif ($detailView && !$authCheck)\n            {{-- Detail view + not logged in: clicking card goes to login --}}\n            <a href=\"{{ route('member.login') }}\" class=\"card-hit absolute inset-0 z-20\"></a>\n        @elseif (!$detailView)\n            {{-- List view: clicking card goes to card detail --}}\n            <a href=\"{{ route('member.card', ['card_id' => $id]) }}\" class=\"card-hit absolute inset-0 z-20\"></a>\n        @endif\n    @endif\n\n    {{-- Background Layer - Pixel-perfect rendering --}}\n    <div class=\"absolute inset-0 z-0 rounded-3xl overflow-hidden\">\n        {{-- Background Image with proper containment --}}\n        @if ($bgImage)\n        <div class=\"absolute inset-0 bg-cover bg-center bg-no-repeat rounded-3xl transform-gpu\" \n             style=\"background-image: url('{{ $bgImage }}'); will-change: auto;\">\n        </div>\n        @endif\n\n        {{-- Colored Overlay - uses rgba for iOS Safari compatibility --}}\n        <div class=\"absolute inset-0 bgColorOverlay_{{ $element_id }} rounded-3xl\"></div>\n\n        {{-- Premium Gradient Overlay - Subtle bottom fade for text legibility --}}\n        <div class=\"absolute inset-0 rounded-3xl bg-gradient-to-t from-black/20 via-transparent to-transparent\"></div>\n    </div>\n\n    {{-- Expired Ribbon --}}\n    @if ($isExpired)\n        <div class=\"absolute right-2 top-2 z-30 pointer-events-none\">\n            <span class=\"px-2 py-1 text-xs font-bold uppercase text-white bg-red-600 rounded shadow-lg\">\n                {{ trans('common.expired') }}\n            </span>\n        </div>\n    @endif\n\n    {{-- Card Content - uses flex to push footer to bottom --}}\n    <div class=\"relative z-10 flex flex-col h-full p-5 @[400px]:p-6 @[500px]:p-8 textColor_{{ $element_id }}\">\n\n        {{-- Header --}}\n        <div class=\"flex items-start justify-between gap-3 mb-4 @[500px]:mb-6\">\n            {{-- Brand --}}\n            <div class=\"flex items-center gap-2 @[500px]:gap-3 min-w-0 relative z-30\">\n                @if ($icon)\n                    <div class=\"flex-none\">\n                        <x-ui.icon :icon=\"$icon\" class=\"w-5 h-5 @[500px]:w-6 @[500px]:h-6 textColor_{{ $element_id }}\" />\n                    </div>\n                @endif\n\n                <div class=\"flex flex-col min-w-0\">\n                    @if ($logo)\n                        <img class=\"h-6 @[400px]:h-7 @[500px]:h-8 object-contain object-left drop-shadow-md\" src=\"{{ $logo }}\" alt=\"{{ parse_attr($contentHead) }}\">\n                    @else\n                        <span class=\"text-sm @[400px]:text-base @[500px]:text-lg font-bold tracking-tight truncate {{ $shadowClass }}\">{{ html_entity_decode($contentHead) }}</span>\n                    @endif\n                    \n                    {{-- Tier Badge --}}\n                    @if ($memberTier && $tierMultiplier > 1)\n                        <div class=\"mt-1.5 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/20 backdrop-blur-sm border border-white/30 w-fit\">\n                            <span class=\"text-sm\">{{ $tierIcon }}</span>\n                            <span class=\"text-xs font-bold tracking-wide\">{{ number_format($tierMultiplier, 1) }}×</span>\n                        </div>\n                    @endif\n                </div>\n            </div>\n\n            {{-- Balance / Earn Points Indicator --}}\n            @if ($authCheck && $showBalance)\n                {{-- Logged in + showBalance: Show balance --}}\n                <div class=\"flex-none relative z-30\">\n                    <div class=\"text-right\">\n                        <div class=\"text-[9px] @[500px]:text-[10px] font-bold uppercase tracking-widest opacity-70 mb-0.5\">\n                            {{ trans('common.balance') }}\n                        </div>\n                        <div class=\"flex items-center justify-end gap-1 @[500px]:gap-1.5 {{ $shadowClass }}\">\n                            <x-ui.icon icon=\"coins\" class=\"w-3.5 h-3.5 @[500px]:w-4 @[500px]:h-4 opacity-90\" />\n                            <span class=\"text-base @[400px]:text-lg @[500px]:text-xl font-mono font-bold tracking-tight format-number\">{{ $balance }}</span>\n                        </div>\n                    </div>\n                </div>\n            @elseif (!$authCheck)\n                {{-- Not logged in: Inviting \"Earn Points\" indicator --}}\n                <div class=\"flex-none relative z-30\">\n                    <div class=\"group/earn relative flex items-center gap-1.5 @[500px]:gap-2 px-2.5 py-1.5 @[500px]:px-3 @[500px]:py-2 \n                                rounded-xl bg-white/20 backdrop-blur-md border border-white/30\n                                transition-all duration-300 ease-out\n                                hover:bg-white/30 hover:border-white/50 hover:scale-105\">\n                        {{-- Shimmer effect --}}\n                        <span class=\"absolute inset-0 rounded-xl overflow-hidden pointer-events-none\">\n                            <span class=\"absolute inset-0 bg-linear-to-r from-transparent via-white/30 to-transparent\n                                         -translate-x-full group-hover/earn:translate-x-full \n                                         transition-transform duration-700 ease-out\"></span>\n                        </span>\n                        {{-- Coins icon --}}\n                        <x-ui.icon icon=\"coins\" class=\"relative w-3.5 h-3.5 @[500px]:w-4 @[500px]:h-4 drop-shadow-sm\" />\n                        {{-- Text --}}\n                        <span class=\"relative text-[10px] @[500px]:text-xs font-semibold tracking-wide whitespace-nowrap drop-shadow-sm\">\n                            {{ trans('common.earn_points') }}\n                        </span>\n                    </div>\n                </div>\n            @endif\n            {{-- authCheck && !showBalance: Show nothing (for partner dashboard previews) --}}\n        </div>\n\n        {{-- Body - flex-1 pushes footer to bottom --}}\n        <div class=\"flex-1 mb-4 @[500px]:mb-8 pointer-events-none\">\n            <h3 class=\"text-lg @[400px]:text-xl @[500px]:text-2xl @[600px]:text-3xl font-light tracking-tight mb-2 @[500px]:mb-3 leading-snug {{ $shadowClass }}\">{{ html_entity_decode($contentTitle) }}</h3>\n            <p class=\"text-xs @[400px]:text-sm @[500px]:text-base font-normal opacity-90 leading-relaxed line-clamp-2 @[500px]:line-clamp-none\">{{ html_entity_decode($contentDescription) }}</p>\n        </div>\n\n        {{-- Footer - always at bottom (no shadow on small details) --}}\n        <div class=\"flex items-center justify-between gap-4 @[500px]:gap-6 pt-4 @[500px]:pt-6 border-t border-white/20 pointer-events-none mt-auto\">\n            <div>\n                <div class=\"text-[9px] @[500px]:text-[10px] font-bold uppercase tracking-widest opacity-60 mb-0.5 @[500px]:mb-1\">\n                    {{ trans('common.identifier') }}\n                </div>\n                <div class=\"font-mono text-xs @[500px]:text-sm tracking-wider\">{{ $identifier }}</div>\n            </div>\n\n            <div class=\"text-right\">\n                <div class=\"text-[9px] @[500px]:text-[10px] font-bold uppercase tracking-widest opacity-60 mb-0.5 @[500px]:mb-1\">\n                    {{ trans('common.expiration_date') }}\n                </div>\n                <div class=\"font-mono text-xs @[500px]:text-sm tracking-wider format-date\" data-date=\"{{ $expirationDate }}\">&nbsp;</div>\n            </div>\n        </div>\n    </div>\n</div>\n\n@php\n    // Convert hex to rgba for iOS Safari compatibility (opacity property can be buggy on iOS)\n    $hex = ltrim($bgColor, '#');\n    if (strlen($hex) === 3) {\n        $hex = $hex[0].$hex[0].$hex[1].$hex[1].$hex[2].$hex[2];\n    }\n    $r = hexdec(substr($hex, 0, 2));\n    $g = hexdec(substr($hex, 2, 2));\n    $b = hexdec(substr($hex, 4, 2));\n    $alpha = $bgColorOpacity / 100;\n@endphp\n<style>\n    #{{ $element_id }} {\n        --card-accent-rgb: {{ $r }}, {{ $g }}, {{ $b }};\n    }\n\n    /* Background overlay with anti-aliasing optimization */\n    .bgColorOverlay_{{ $element_id }} {\n        background-color: rgba({{ $r }}, {{ $g }}, {{ $b }}, {{ $alpha }});\n        /* Prevent scaling artifacts */\n        backface-visibility: hidden;\n        transform: translateZ(0);\n        -webkit-font-smoothing: subpixel-antialiased;\n    }\n\n    .textColor_{{ $element_id }} {\n        color: {{ $textColor }};\n    }\n</style>\n"
    },
