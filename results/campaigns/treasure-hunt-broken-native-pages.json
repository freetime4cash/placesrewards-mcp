            "method_source": {
                "class": "App\\Http\\Controllers\\Member\\ScratchCardController",
                "method": "show",
                "file": "/home/placevle/app.placesrewards.com/app/Http/Controllers/Member/ScratchCardController.php",
                "source": "    public function show(string $locale, ScratchCard $scratchCard)\n    {\n        $this->authorizeMember($scratchCard);\n        $scratchCard->load('scratchGame');\n        return view('member.scratch-cards.show', compact('scratchCard'));\n    }\n"
            }
        },
        {
            "uri": "{locale}/scratch-cards/{scratchCard}/play",
            "methods": [
                "POST"
            ],
            "name": "member.scratch-cards.play",
            "action": "App\\Http\\Controllers\\Member\\ScratchCardController@play",
            "middleware": [
                "web",
                "member.auth.auto",
                "member.role:1,2,3"
            ],
            "method_source": {
                "class": "App\\Http\\Controllers\\Member\\ScratchCardController",
                "method": "play",
                "file": "/home/placevle/app.placesrewards.com/app/Http/Controllers/Member/ScratchCardController.php",
                "source": "    public function play(string $locale, ScratchCard $scratchCard)\n    {\n        $this->authorizeMember($scratchCard);\n\n        if ($scratchCard->is_played) {\n            return response()->json([\n                'already_played' => true,\n                'is_winner'      => $scratchCard->is_winner,\n            ]);\n        }\n\n        $scratchCard->update([\n            'is_played' => true,\n            'played_at' => now(),\n        ]);\n\n        // Award XP for scratch card play\n        try {\n            $xpService = app(XpService::class);\n            $xpService->award(auth('member')->user(), 'scratch_card_play', $scratchCard->partner_id, 'scratch_card', $scratchCard->id);\n            if ($scratchCard->is_winner) {\n                $xpService->award(auth('member')->user(), 'scratch_card_win', $scratchCard->partner_id, 'scratch_card', $scratchCard->id);\n            }\n        } catch (\\Throwable $e) {}\n\n        return response()->json([\n            'is_winner'  => $scratchCard->is_winner,\n            'win_image'  => $scratchCard->scratchGame->win_image\n                ? asset('storage/' . $scratchCard->scratchGame->win_image)\n                : null,\n            'loss_image' => $scratchCard->scratchGame->loss_image\n                ? asset('storage/' . $scratchCard->scratchGame->loss_image)\n                : null,\n        ]);\n    }\n"
            }
        }
    ],
